generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum MessageCategory {
  GENERAL
  TICKETS
  VIP
  PARTNERSHIP
  VENDOR
  MEDIA
  LOST_AND_FOUND
  OTHER
}

enum MessagePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FaqStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  CONTACT_MESSAGE
  EVENT
  TICKET
  GALLERY
  FAQ
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  DRAFT
  SCHEDULED
  AVAILABLE
  LIMITED
  SOLD_OUT
  EXPIRED
  HIDDEN
}

enum TicketCategory {
  GENERAL
  EARLY_BIRD
  VIP
  GROUP
  PACKAGE
  ADD_ON
  TRANSPORT
  OTHER
}

enum TicketAvailabilityMode {
  MANUAL
  EXTERNAL_API
  HIDDEN
}

enum TicketProvider {
  EVENTPOP
  OTHER
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole  @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

model Event {
  id                Int         @id @default(autoincrement())
  title             String
  slug              String      @unique
  description       String
  date              DateTime
  location          String
  heroImageUrl      String?
  heroImagePublicId String?
  capacity          Int?
  remainingTickets  Int?
  status            EventStatus @default(DRAFT)

  ticketProvider    TicketProvider @default(EVENTPOP)
  ticketPurchaseUrl String?
  externalEventId   String?

  galleryImages GalleryImage[]
  tickets       TicketPreview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([date])
  @@index([ticketProvider])
  @@index([externalEventId])
  @@index([createdAt])
}

model TicketPreview {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name             String
  slug             String
  shortDescription String?
  description      String?

  category TicketCategory @default(GENERAL)
  status   TicketStatus   @default(DRAFT)

  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  currency      String   @default("THB")

  availabilityMode  TicketAvailabilityMode @default(HIDDEN)
  totalQuantity     Int?
  remainingQuantity Int?
  availabilityLabel String?

  saleStartsAt DateTime?
  saleEndsAt   DateTime?

  minimumPerOrder Int?
  maximumPerOrder Int?

  externalPurchaseUrl String?
  externalTicketId    String?

  badge      String?
  imageUrl   String?
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  benefits TicketBenefit[]

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([eventId, slug])
  @@index([eventId])
  @@index([status])
  @@index([category])
  @@index([availabilityMode])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([saleStartsAt])
  @@index([saleEndsAt])
  @@index([externalTicketId])
  @@index([createdAt])
}

model TicketBenefit {
  id Int @id @default(autoincrement())

  ticketPreviewId Int
  ticketPreview   TicketPreview @relation(fields: [ticketPreviewId], references: [id], onDelete: Cascade)

  text      String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketPreviewId])
  @@index([sortOrder])
  @@index([createdAt])
}

model ContactMessage {
  id      Int     @id @default(autoincrement())
  name    String
  email   String
  phone   String?
  subject String?
  message String

  category MessageCategory @default(GENERAL)
  priority MessagePriority @default(NORMAL)
  status   MessageStatus   @default(NEW)

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([email])
  @@index([createdAt])
}

model GalleryImage {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String
  altText     String?
  status      GalleryStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  sortOrder   Int           @default(0)

  eventId Int?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([eventId])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([createdAt])
}

model Faq {
  id        Int       @id @default(autoincrement())
  question  String
  answer    String
  category  String?
  status    FaqStatus @default(DRAFT)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([sortOrder])
  @@index([createdAt])
}

model Notification {
  id       Int                  @id @default(autoincrement())
  title    String
  message  String
  type     NotificationType
  priority NotificationPriority @default(NORMAL)

  isRead Boolean @default(false)
  link   String?

  contactMessageId Int?
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([type])
  @@index([priority])
  @@index([isRead])
  @@index([contactMessageId])
  @@index([createdAt])
}

model ExperiencePage {
  id Int @id @default(autoincrement())

  heroBadge       String?
  heroTitle       String
  heroSubtitle    String?
  heroDescription String?

  storyEyebrow     String?
  storyTitle       String
  storyDescription String

  buttonText String?
  buttonUrl  String?

  isPublished Boolean @default(false)

  highlights ExperienceHighlight[]
  images     ExperienceImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([createdAt])
}

model ExperienceHighlight {
  id Int @id @default(autoincrement())

  title       String
  description String
  icon        String?
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)

  experiencePageId Int
  experiencePage   ExperiencePage @relation(fields: [experiencePageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([experiencePageId])
  @@index([sortOrder])
  @@index([isVisible])
  @@index([createdAt])
}

model ExperienceImage {
  id Int @id @default(autoincrement())

  imageUrl   String
  altText    String?
  caption    String?
  sortOrder  Int     @default(0)
  isFeatured Boolean @default(false)
  isVisible  Boolean @default(true)

  experiencePageId Int
  experiencePage   ExperiencePage @relation(fields: [experiencePageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([experiencePageId])
  @@index([sortOrder])
  @@index([isFeatured])
  @@index([isVisible])
  @@index([createdAt])
}
