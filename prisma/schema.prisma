generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum MessageCategory {
  GENERAL
  TICKETS
  VIP
  PARTNERSHIP
  VENDOR
  MEDIA
  LOST_AND_FOUND
  OTHER
}

enum MessagePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FaqStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  CONTACT_MESSAGE
  EVENT
  TICKET
  GALLERY
  FAQ
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole  @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

model Event {
  id               Int         @id @default(autoincrement())
  title            String
  slug             String      @unique
  description      String
  date             DateTime
  location         String
  heroImageUrl     String?
  capacity         Int?
  remainingTickets Int?
  status           EventStatus @default(DRAFT)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  galleryImages GalleryImage[]

  @@index([status])
  @@index([date])
  @@index([createdAt])
}

model ContactMessage {
  id      Int     @id @default(autoincrement())
  name    String
  email   String
  phone   String?
  subject String?
  message String

  category MessageCategory @default(GENERAL)
  priority MessagePriority @default(NORMAL)
  status   MessageStatus   @default(NEW)

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([email])
  @@index([createdAt])
}

model GalleryImage {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String
  altText     String?
  status      GalleryStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  sortOrder   Int           @default(0)

  eventId Int?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([eventId])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([createdAt])
}

model Faq {
  id        Int       @id @default(autoincrement())
  question  String
  answer    String
  category  String?
  status    FaqStatus @default(DRAFT)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([sortOrder])
  @@index([createdAt])
}

model Notification {
  id       Int                  @id @default(autoincrement())
  title    String
  message  String
  type     NotificationType
  priority NotificationPriority @default(NORMAL)

  isRead Boolean @default(false)
  link   String?

  contactMessageId Int?
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([type])
  @@index([priority])
  @@index([isRead])
  @@index([contactMessageId])
  @@index([createdAt])
}

model ExperiencePage {
  id Int @id @default(autoincrement())

  heroBadge       String?
  heroTitle       String
  heroSubtitle    String?
  heroDescription String?

  storyEyebrow     String?
  storyTitle       String
  storyDescription String

  buttonText String?
  buttonUrl  String?

  isPublished Boolean @default(false)

  highlights ExperienceHighlight[]
  images     ExperienceImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([createdAt])
}

model ExperienceHighlight {
  id Int @id @default(autoincrement())

  title       String
  description String
  icon        String?
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)

  experiencePageId Int
  experiencePage   ExperiencePage @relation(fields: [experiencePageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([experiencePageId])
  @@index([sortOrder])
  @@index([isVisible])
  @@index([createdAt])
}

model ExperienceImage {
  id Int @id @default(autoincrement())

  imageUrl   String
  altText    String?
  caption    String?
  sortOrder  Int     @default(0)
  isFeatured Boolean @default(false)
  isVisible  Boolean @default(true)

  experiencePageId Int
  experiencePage   ExperiencePage @relation(fields: [experiencePageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([experiencePageId])
  @@index([sortOrder])
  @@index([isFeatured])
  @@index([isVisible])
  @@index([createdAt])
}
