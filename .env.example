# ============================================================================
# Waterfall Festival Backend
# Environment Variables
# ============================================================================

# Server
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/waterfall_festival?schema=public"

# ============================================================================
# Authentication
# ============================================================================

JWT_SECRET=your-super-long-random-secret
JWT_EXPIRES_IN=1d

# Default Admin Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
ADMIN_FIRST_NAME=Festival
ADMIN_LAST_NAME=Admin

# ============================================================================
# Cloudinary
# ============================================================================

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================================
# SMTP Email
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password

MAIL_FROM_NAME=Waterfall Festival
MAIL_FROM_ADDRESS=your-email@example.com